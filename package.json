{
  "name": "claude-artifact-downloader",
  "private": true,
  "version": "0.6.0",
  "description": "Browser extension that downloads a claude.ai artifact as a project zip",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webidoo/claude-artifact-downloader.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
