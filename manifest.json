{
  "manifest_version": 3,
  "name": "Artifact Downloader for Claude",
  "version": "0.6.0",
  "description": "Download the claude.ai artifact you are viewing as a ready-to-use project zip. Unofficial - not affiliated with Anthropic.",
  "homepage_url": "https://github.com/webidoo/claude-artifact-downloader",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Artifact Downloader for Claude"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["https://*.claudeusercontent.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/code/artifact/*",
        "https://claude.ai/code/frame/*",
        "https://claude.ai/artifact/*",
        "https://claude.ai/frame/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.frame.claudeusercontent.com/*"],
      "js": ["frame-content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
