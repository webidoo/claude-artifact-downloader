{
  "manifest_version": 3,
  "name": "Claude Artifact Downloader",
  "version": "0.4.0",
  "description": "Download the claude.ai artifact you are viewing as a project zip.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Artifact Downloader"
  },
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/code/artifact/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["https://*.frame.claudeusercontent.com/*"]
}
